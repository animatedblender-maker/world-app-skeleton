# Copy to apps/api/.env and fill in real values.
# cp apps/api/.env.example apps/api/.env

# --- existing (required for API) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PGSSLMODE=require
PORT=3000
WEB_ORIGIN=http://localhost:4200

# LiveKit / push — keep your existing keys
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# APNS_...

# --- Kafka ---
# Local Docker:  npm run kafka:up  (from repo root)
# Production (Render): use managed Kafka (Upstash / Redpanda Cloud) — not localhost
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=matterya-api
KAFKA_CONSUMER_GROUP=matterya-api-workers
# KAFKA_SHADOW=true
# Managed cloud (Render):
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_REPLICATION_FACTOR=3
