{
  "name": "world-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:media-worker": "node dist/media/worker-main.js",
    "dev:media-worker": "tsx src/media/worker-main.ts",
    "render-build": "npm ci --no-workspaces --include=dev && npm run build",
    "content-pipeline": "tsx src/content-pipeline/cli.ts",
    "content-pipeline:dry": "tsx src/content-pipeline/cli.ts --dry-run",
    "media:frame0-backfill": "tsx src/media/frame0-backfill.ts",
    "media:frame0-backfill:dry": "tsx src/media/frame0-backfill.ts --dry-run",
    "docker:media-worker:build": "docker build -f Dockerfile.media-worker -t matterya-media-worker ."
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@supabase/supabase-js": "^2.89.0",
    "@xenova/transformers": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.10.0",
    "jose": "^6.1.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.16.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
