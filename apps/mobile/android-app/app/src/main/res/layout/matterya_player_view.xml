<?xml version="1.0" encoding="utf-8"?>
<!--
  texture_view keeps the last painted bitmap after the ExoPlayer leaves this view.
  Critical for Feed→Sparks handoff: Feed film stays visible under a transparent Sparks
  stage until the new surface fires onRenderedFirstFrame (SurfaceView went black).
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/matterya_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/transparent"
    app:keep_content_on_player_reset="true" />
