{
  "name": "world-app",
  "private": true,
  "scripts": {
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:migration:new": "supabase migration new",
    "db:seed": "supabase db seed",
    "kafka:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "kafka:down": "docker compose -f infra/docker/docker-compose.yml down",
    "kafka:logs": "docker compose -f infra/docker/docker-compose.yml logs -f redpanda",
    "demo:import:kaggle-reddit": "python3 scripts/import_kaggle_reddit_dataset.py",
    "mobile:ios": "npm --workspace apps/mobile run ios:open",
    "mobile:android": "npm --workspace apps/mobile run android:open",
    "mobile:android:run": "npm --workspace apps/mobile run android:run"
  },
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/*"
  ],
  "dependencies": {
    "maplibre-gl": "^5.15.0",
    "ngx-image-cropper": "^9.1.5",
    "three": "^0.182.0"
  }
}
